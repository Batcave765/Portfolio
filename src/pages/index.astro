---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resume = `${base}/Sriram_M_Software_Engineer_Resume.pdf`;
const skills = [
  ['Languages', ['TypeScript', 'Go', 'JavaScript', 'Python', 'Java', 'C/C++', 'SQL']],
  ['Frontend & mobile', ['React Native', 'Expo', 'Next.js', 'React', 'Tailwind CSS', 'NativeWind']],
  ['Backend & data', ['Spring Boot', 'SpacetimeDB', 'MMKV · C++ JSI', 'Drizzle ORM', 'MySQL', 'MongoDB']],
  ['Cloud & observability', ['GCP', 'Grafana', 'Dynatrace', 'Elasticsearch']],
  ['Tools & infrastructure', ['GitLab CI/CD', 'Docker', 'Docker Compose', 'Bun', 'Git', 'FFmpeg', 'Postman']],
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfbfb" id="theme-color" />
    <meta name="description" content="Sriram M. — software engineer in Chennai. Performance engineering at Cognizant for Macy’s, developer automation, and local-first applications built with Go and TypeScript." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={`${base}/fonts/manrope-400-800.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/chakra-petch-600.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <title>Sriram M. — Software Engineer</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
      document.querySelector('#theme-color').setAttribute('content', document.documentElement.dataset.theme === 'dark' ? '#252130' : '#fbfbfb');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" id="site-header">
      <a class="wordmark" href="#top" aria-label="Sriram M. — back to top"><span class="brand-mark" aria-hidden="true">s<span>m</span></span><span>Sriram M.</span></a>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#expertise">Skills</a>
        <a href="#contact">Contact <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
          <svg class="sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          <svg class="moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 14.1A9 9 0 0 1 9.9 3.2a9 9 0 1 0 10.9 10.9Z" /></svg>
        </button>
        <a class="header-resume" href={resume} target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span>Menu</span><span class="menu-symbol" aria-hidden="true">+</span></button>
      </div>
    </header>

    <main id="main-content">
      <section class="hero shell" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hello"><span class="hello-line" aria-hidden="true"></span>Hello, I’m Sriram M.</p>
          <h1 id="hero-title">Faster systems.<br /><span>Fewer bottlenecks.</span></h1>
          <p class="hero-role">Software engineer. Performance minded.</p>
          <p class="hero-description">I build dependable systems, local-first apps, and tools that give developers their time back.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={resume} target="_blank" rel="noopener">View résumé <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#projects">Explore my work <span aria-hidden="true">↓</span></a>
          </div>
          <div class="current-role"><span class="status-dot" aria-hidden="true"></span><p>Currently at <strong>Cognizant</strong><br /><span>Performance &amp; automation · Macy’s Supply Chain</span></p></div>
        </div>
        <figure class="portrait">
          <div class="portrait-stage">
            <div class="portrait-disc" aria-hidden="true"></div>
            <picture>
              <source srcset={`${base}/sriram-portrait.webp`} type="image/webp" />
              <img src={`${base}/Sriram1.jpg`} alt="Sriram M. smiling outdoors." width="1824" height="1368" fetchpriority="high" />
            </picture>
            <span class="portrait-corner" aria-hidden="true">↗</span>
            <span class="portrait-label">A builder at heart.</span>
          </div>
          <figcaption><span class="location"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15.5 8c0 4-5.5 9-5.5 9S4.5 12 4.5 8a5.5 5.5 0 1 1 11 0Z" /><circle cx="10" cy="8" r="1.8" /></svg>Chennai, India</span><span>Go · TypeScript · Python</span></figcaption>
        </figure>
      </section>

      <aside class="proof-band" aria-label="Selected engineering impact">
        <div class="shell proof-inner"><p class="proof-intro">Less friction.<br /><strong>More forward.</strong></p><p><span class="proof-icon" aria-hidden="true">↗</span><span>Systems tested at <strong>3,000 transactions/sec</strong><small>Order creation, returns, and refunds at Macy’s</small></span></p><p><span class="proof-icon" aria-hidden="true">↗</span><span><strong>3–4 hours of manual work saved</strong><small>Per release cycle through Python automation</small></span></p></div>
      </aside>

      <section class="experience shell section" id="experience" aria-labelledby="experience-title">
        <div class="section-heading"><h2 id="experience-title">Where I’ve<br />made an impact<span class="accent">.</span></h2><p>From enterprise-scale performance to the details that make an interface work.</p></div>
        <article class="job">
          <div class="job-context"><p class="job-date">Feb 2025 — Present</p><h3>Cognizant</h3><p>Technology Solutions<br />Chennai, India</p><span class="tag tag-current">Current role</span></div>
          <div class="job-content"><h4>Performance &amp; Automation Engineer</h4><p class="client">Client: Macy’s Supply Chain</p><ul class="work-list">
            <li><strong>Test the critical paths.</strong> Build custom k6 frameworks for the Unified Orders Platform, covering order creation, returns, and refunds.</li>
            <li><strong>Make testing self-service.</strong> Engineered a developer tool in GitLab CI/CD to automate test execution and dynamic report generation.</li>
            <li><strong>Turn logs into useful answers.</strong> Built Python reporting automation that eliminates 3–4 hours of manual developer effort per release cycle.</li>
            <li><strong>Find the bottleneck.</strong> Analyze microservices under 3,000 TPS using GCP logs, Grafana, and Dynatrace to isolate architectural and database constraints.</li>
          </ul><div class="tags" aria-label="Technologies used"><span class="tag">k6</span><span class="tag">Python</span><span class="tag">GitLab CI/CD</span><span class="tag">GCP</span><span class="tag">Grafana</span><span class="tag">Dynatrace</span></div></div>
        </article>
        <article class="job job-intern"><div class="job-context"><p class="job-date">May — Jul 2023</p><h3>DevCrew</h3><p>Coimbatore, India</p></div><div class="job-content"><h4>Web Development Intern</h4><ul class="work-list"><li>Built frontend features and refactored core UI components for client projects using <strong>React and Next.js.</strong></li><li>Resolved runtime bugs and interface regressions to improve frontend stability and user experience.</li></ul></div></article>
      </section>

      <section class="projects section" id="projects" aria-labelledby="projects-title">
        <div class="shell section-heading">
          <h2 id="projects-title">Curiosity,<br />shipped<span class="accent">.</span></h2>
          <div class="project-intro">
            <p>My friend Rishikesh S and I build these apps together as YeetFactory.</p>
            <a class="button button-primary" href="https://yeetfactory.top/" target="_blank" rel="noopener">Visit yeetfactory.top <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <article class="project shell">
          <div class="project-visual rexi-visual" role="img" aria-label="Rexi groups doses into four pillbox compartments. When a dose is due, you can mark it taken, snooze it, or skip it.">
            <div class="visual-topline"><span>Rexi / Android application</span><span aria-hidden="true">↗</span></div>
            <div class="project-illustration"><div class="pillbox"><span>Morning</span><strong>Afternoon</strong><span>Evening</span><span>Night</span></div></div>
            <div class="project-path"><span>Schedule</span><b aria-hidden="true">→</b><span>Reminder</span><b aria-hidden="true">→</b><span>Dose response</span></div>
          </div>
          <div class="project-copy">
            <p class="project-type">Offline medication tracker</p>
            <h3>Rexi</h3>
            <p>An Android app that lays out each day as a four-compartment pillbox and keeps medication schedules and history on the phone.</p>
            <div class="project-takeaway"><span aria-hidden="true">↳</span><p><strong>Privacy on shared phones.</strong> Lock the app with a fingerprint or PIN and hide medication names in notifications.</p></div>
            <div class="project-meta">
              <div class="tags"><span class="tag">Kotlin</span><span class="tag">Jetpack Compose</span><span class="tag">Room</span></div>
              <a class="text-link" href="https://github.com/yeetfactory/rexi" target="_blank" rel="noopener" aria-label="GitHub repository for Rexi">GitHub <span aria-hidden="true">↗</span></a>
            </div>
            <details>
              <summary>Engineering details <span aria-hidden="true">+</span></summary>
              <ul><li>Take, snooze, or skip a dose from a notification, full-screen reminder, or home screen widget.</li><li>Track remaining medication and export 30 days of dose history as a PDF.</li><li>A local backup file lets you move your history to a new phone.</li></ul>
            </details>
          </div>
        </article>
        <article class="project project-reverse shell">
          <div class="project-visual" role="img" aria-label="Déjà scans for nearby Bluetooth and Wi-Fi devices, records sightings, and flags repeat encounters.">
            <div class="visual-topline"><span>Déjà / Android application</span><span aria-hidden="true">↗</span></div>
            <div class="project-illustration sightings"><span class="sighting">First seen</span><span aria-hidden="true">→</span><strong class="sighting">Seen again</strong></div>
            <div class="project-path"><span>Bluetooth / Wi-Fi</span><b aria-hidden="true">→</b><span>Sightings</span><b aria-hidden="true">→</b><span>Alerts</span></div>
          </div>
          <div class="project-copy">
            <p class="project-type">Nearby device awareness</p>
            <h3>Déjà</h3>
            <p>An Android app that remembers nearby Bluetooth and Wi-Fi devices and flags when one returns or appears to follow you between places.</p>
            <div class="project-takeaway"><span aria-hidden="true">↳</span><p><strong>Alerts with evidence.</strong> Repeated sightings across distinct places can trigger an alert with a timeline of the encounters.</p></div>
            <div class="project-meta">
              <div class="tags"><span class="tag">Kotlin</span><span class="tag">Jetpack Compose</span><span class="tag">Room</span></div>
              <a class="text-link" href="https://github.com/yeetfactory/deja" target="_blank" rel="noopener" aria-label="GitHub repository for Déjà">GitHub <span aria-hidden="true">↗</span></a>
            </div>
            <details>
              <summary>Engineering details <span aria-hidden="true">+</span></summary>
              <ul><li>Treats rotating Bluetooth addresses as separate encounters.</li><li>Shows live signal strength and exports alert timelines as CSV.</li><li>Keeps sightings on-device and lets you choose how long to retain them.</li></ul>
            </details>
          </div>
        </article>
        <article class="project shell">
          <div class="project-visual recur-visual" role="img" aria-label="Recur architecture: React Native interface, Zod validation, and MMKV storage, all on device.">
            <div class="visual-topline"><span>Recur / Mobile application</span><span aria-hidden="true">↗</span></div>
            <div class="project-illustration local-orbit"><div class="orbit-ring orbit-ring-outer"></div><div class="orbit-ring orbit-ring-inner"></div><span class="orbit-label">Local-first.</span><strong>On your<br />device.</strong><span class="orbit-node" aria-hidden="true"></span></div>
            <div class="project-path"><span>React Native</span><b aria-hidden="true">→</b><span>Zod</span><b aria-hidden="true">→</b><span>MMKV</span></div>
          </div>
          <div class="project-copy">
            <p class="project-type">Local-first subscription tracker</p>
            <h3>Recur</h3>
            <p>Your subscriptions, with state that feels immediate. A cross-platform mobile app built around fast, on-device storage.</p>
            <div class="project-takeaway"><span aria-hidden="true">↳</span><p><strong>Direct to native storage.</strong> MMKV via C++ JSI bindings bypasses asynchronous overhead for near-instant state operations.</p></div>
            <div class="project-meta">
              <div class="tags"><span class="tag">TypeScript</span><span class="tag">React Native</span><span class="tag">Expo</span><span class="tag">MMKV</span></div>
              <a class="text-link" href="https://github.com/yeetfactory/recur" target="_blank" rel="noopener" aria-label="GitHub repository for Recur">GitHub <span aria-hidden="true">↗</span></a>
            </div>
            <details><summary>Engineering details <span aria-hidden="true">+</span></summary><ul><li>Expo v54 with the React Native New Architecture fully enabled.</li><li>Zod schema validation enforces type safety and sanitizes database reads and writes.</li><li>React Native Reanimated, NativeWind, and accessible Radix UI primitives power the interface.</li></ul></details>
          </div>
        </article>
      </section>

      <section class="expertise section" id="expertise" aria-labelledby="expertise-title"><div class="shell expertise-layout"><div class="expertise-heading"><h2 id="expertise-title">The working<br />toolkit<span class="accent">.</span></h2><p>Across the stack.<br />Close to the system.</p></div><dl class="skills-list">{skills.map(([label, items]) => <div><dt>{label}</dt><dd>{Array.isArray(items) && items.map(item => <span>{item}</span>)}</dd></div>)}</dl></div></section>

      <section class="foundations shell section" aria-label="Education and recognition"><div class="education"><h2>Built on solid ground.</h2><p class="education-degree">B.Tech, Information Technology</p><p>Sri Krishna College of Engineering and Technology</p><p class="muted">Coimbatore, India · Jun 2021 — Jun 2025</p></div><div class="awards"><h2>A little recognition.</h2><div class="award"><span class="award-symbol" aria-hidden="true">✳</span><div><h3>Second Runner-up · National</h3><p>Innohacks ’22 · May 2022</p><p class="muted">KIET / Innogeeks, New Delhi</p></div></div><div class="award"><span class="award-symbol" aria-hidden="true">✳</span><div><h3>Most Impactful Hack · National</h3><p>Hack @ SKCET · Feb 2022</p><p class="muted">Hackclub SKCET, Coimbatore</p></div></div></div></section>

    </main>

    <footer class="contact" id="contact"><div class="shell"><div class="contact-main"><div><p class="contact-intro">Have a role or a problem in mind?</p><h2>Let’s build<br />what’s next<span aria-hidden="true">↗</span></h2></div><div class="contact-actions"><a class="contact-email" href="mailto:msriram765@gmail.com">msriram765@gmail.com <span aria-hidden="true">↗</span></a><a href="tel:+919342356813">+91 93423 56813</a><div class="contact-socials"><a href="https://www.linkedin.com/in/sriram-m765/" target="_blank" rel="noopener">LinkedIn ↗</a><a href="https://github.com/Batcave765" target="_blank" rel="noopener">GitHub ↗</a><a href={resume} target="_blank" rel="noopener">Résumé ↗</a></div></div></div><div class="footer-bottom"><p>© {new Date().getFullYear()} Sriram M. <span>Built with intent. Based in Chennai.</span></p><a href="#top">Back to top <span aria-hidden="true">↑</span></a></div></div></footer>

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const menuToggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const header = document.querySelector('#site-header');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const mobile = matchMedia('(max-width: 760px)');
      function syncTheme() {
        const dark = root.dataset.theme === 'dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
        themeToggle?.setAttribute('aria-pressed', String(dark));
        document.querySelector('#theme-color')?.setAttribute('content', dark ? '#252130' : '#fbfbfb');
      }
      syncTheme();
      themeToggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        syncTheme();
      });
      function setMenu(open: boolean) {
        header?.classList.toggle('menu-open', open);
        menuToggle?.setAttribute('aria-expanded', String(open));
        if (nav) nav.inert = mobile.matches && !open;
      }
      setMenu(false);
      menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          menuToggle.focus();
        }
      });
      document.addEventListener('click', event => { if (event.target instanceof Node && !header?.contains(event.target)) setMenu(false); });
      mobile.addEventListener('change', () => setMenu(false));
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
